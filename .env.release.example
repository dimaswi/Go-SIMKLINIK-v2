# Runtime env for VPS deployment.
# Frontend build-time env is separate: build the frontend image with VITE_API_URL=/api.

BACKEND_IMAGE=docker.io/dimasw347/simklinik-backend:1.0.0
FRONTEND_IMAGE=docker.io/dimasw347/simklinik-frontend:1.0.0

# PostgreSQL runtime credentials used by compose and backend container.
POSTGRES_USER=simklinik
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=simklinik

# Application secret.
JWT_SECRET=change-me-with-a-long-random-secret

# Host ports exposed by the VPS.
# BACKEND_PORT dipakai untuk bind backend ke host, tetapi di compose release hanya dibuka ke 127.0.0.1.
# Biasanya tetap 8080 kecuali port itu sudah dipakai service lain di VPS.
# FRONTEND_PORT adalah port yang diakses browser dari luar VPS.
# Jika mau akses aplikasi lewat http://IP-VPS:3000 maka biarkan 3000.
# Jika mau akses lewat http://IP-VPS:8088 maka ubah FRONTEND_PORT=8088.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Backend config actually consumed by backend/config/config.go.
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Jakarta
CORS_ALLOWED_ORIGINS=https://aryo.wismed.my.id,http://aryo.wismed.my.id,http://119.28.111.184:3000,http://119.28.111.184,http://localhost:3000

# System backup defaults consumed by backend/config/config.go.
BACKUP_DEFAULT_CRON=0 2 * * *
BACKUP_DEFAULT_RETENTION_DAYS=7
BACKUP_DEFAULT_INCLUDE_UPLOADS=true