# Copy this file to cloudflared/config.yml and adjust values.
# Place your tunnel credentials JSON in the same folder.

tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_ID.json

ingress:
  - hostname: simrs.domain-anda.com
    service: http://simklinik-frontend:80
    originRequest:
      disableChunkedEncoding: true
  - service: http_status:404
