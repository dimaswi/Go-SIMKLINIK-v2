APP_ENV=production

POSTGRES_USER=simklinik
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=simklinik
POSTGRES_PORT=5434

BACKEND_PORT=8080
FRONTEND_PORT=3000

JWT_SECRET=change-me-with-a-long-random-secret
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Jakarta

# Tambahkan domain frontend yang valid untuk akses browser per klinik.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://klinik-anda.example.com